// Caso overrun: el software atiende tarde (retraso de servicio de 0 a 20 caracteres, valor del plan) y la FIFO RX se llena
// Iterations and TX/RX burst sizes use the plan defaults (20 iterations, bursts of 0 to 20)
// Leave line-format weights unchanged so supported formats can still vary across seeds

// Keep the baud rate fast here so the first integration run does not spend most of its time waiting
// Disable break and loopback until their stimulus and checking are ready
+UART_LCR_DL_ZERO_PCT=0
+UART_LCR_DL_FAST_MAX=8
+UART_LCR_DL_MAX=8
+UART_LCR_DL_TAIL_PCT=0
+UART_LCR_BC_PCT=0
+UART_MCR_LOOP_PCT=0

// Use polling because interrupt-driven service is still pending
// Turn the other software behaviors off explicitly so the run cannot silently skip requested work
+UART_SW_MODE_WEIGHTS=0,1
+UART_SW_SERVICE_DELAY_MIN=0
+UART_SW_SERVICE_DELAY_MAX=20
+UART_SW_BLIND_READ_PCT=0
+UART_SW_RAND_ACCESS_PCT=0
+UART_SW_RECFG_PCT=0
+UART_SW_RST_PCT=0

// Use regular byte selection and normal serial frames for this stage
// Leave error injection and modem changes off until those paths have real implementations
+UART_WB_SEL_ODD_PCT=0
+UART_SER_PARITY_ERR_PCT=0
+UART_SER_FRAME_ERR_PCT=0
+UART_SER_BREAK_PCT=0
+UART_SER_STOP2_ERR_PCT=0
+UART_SER_GLITCH_PCT=0
+UART_SER_BAUD_ERR_PCT=0
+UART_MDM_TOGGLE_PCT=0

// BUG-04 dispensado: con la FIFO RX llena el DUT pisa el dato mas viejo en vez de perder el nuevo
+UART_SCB_WAIVE_BUGS=4
